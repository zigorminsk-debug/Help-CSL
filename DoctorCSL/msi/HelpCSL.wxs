<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="Help CSL 1.11.17"
      Language="1049"
      Codepage="1251"
      Version="1.11.17"
      Manufacturer="CSL"
      UpgradeCode="A7E4C1B0-5D2F-4A18-9C6E-1B8F0D3A7E21">

    <Package
        InstallerVersion="200"
        Compressed="yes"
        InstallScope="perUser"
        Description="Help CSL — установка"
        Comments="Help CSL уже в пути"
        Manufacturer="CSL"
        Languages="1049" />

    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Help CSL is already installed." />

    <Media Id="1" Cabinet="helpcsl.cab" EmbedCab="yes" />

    <Property Id="LIMITUI" Value="1" />
    <Property Id="DISABLEADVTSHORTCUTS" Value="1" />
    <Property Id="REBOOT" Value="ReallySuppress" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://h.csl.by" />
    <Property Id="ARPURLINFOABOUT" Value="https://csl.by" />
    <Property Id="ARPCOMMENTS" Value="Help CSL already on the way" />

    <Icon Id="AppIcon" SourceFile="icon.ico" />

    <!-- Запуск без FileKey (тип 18 давал ошибку 2753). -->
    <CustomAction Id="SetLaunch" Property="LaunchHelpCSL" Value="[INSTALLDIR]HelpCSL.exe" />
    <CustomAction Id="LaunchApp" Property="LaunchHelpCSL" ExeCommand="" Return="asyncNoWait" Impersonate="yes" />

    <InstallExecuteSequence>
      <Custom Action="SetLaunch" After="InstallFinalize">NOT REMOVE="ALL"</Custom>
      <Custom Action="LaunchApp" After="SetLaunch">NOT REMOVE="ALL"</Custom>
    </InstallExecuteSequence>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder" Name="LocalAppData">
        <Directory Id="COMPANYDIR" Name="CSL">
          <Directory Id="INSTALLDIR" Name="HelpCSL">
            <Component Id="MainExe" Guid="B1C2D3E4-5F60-4781-9A2B-3C4D5E6F7081">
              <File Id="HelpCSLEXE" Name="HelpCSL.exe" Source="HelpCSL.exe" KeyPath="yes" />
            </Component>
            <Component Id="Autostart" Guid="C2D3E4F5-6071-4892-AB3C-4D5E6F708192">
              <RegistryValue
                  Root="HKCU"
                  Key="Software\Microsoft\Windows\CurrentVersion\Run"
                  Name="HelpCSL"
                  Type="string"
                  Value="[#HelpCSLEXE]"
                  KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>

      <Directory Id="ProgramMenuFolder" Name="Programs">
        <Directory Id="ProgramMenuDir" Name="Help CSL">
          <Component Id="StartMenuShortcut" Guid="D3E4F506-7182-49A3-BC4D-5E6F708192A3">
            <Shortcut
                Id="StartMenuLnk"
                Name="Help CSL"
                Description="Help CSL"
                Target="[#HelpCSLEXE]"
                WorkingDirectory="INSTALLDIR"
                Icon="AppIcon" />
            <RemoveFolder Id="RemoveProgramMenuDir" On="uninstall" />
            <RegistryValue
                Root="HKCU"
                Key="Software\CSL\HelpCSL"
                Name="StartMenu"
                Type="integer"
                Value="1"
                KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>

      <Directory Id="DesktopFolder" Name="Desktop">
        <Component Id="DesktopShortcut" Guid="E4F50617-8293-4AB4-CD5E-6F708192A3B4">
          <Shortcut
              Id="DesktopLnk"
              Name="Help CSL"
              Description="Help CSL"
              Target="[#HelpCSLEXE]"
              WorkingDirectory="INSTALLDIR"
              Icon="AppIcon" />
          <RegistryValue
              Root="HKCU"
              Key="Software\CSL\HelpCSL"
              Name="Desktop"
              Type="integer"
              Value="1"
              KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Complete" Title="Help CSL" Description="Help CSL" Level="1">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="Autostart" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Product>
</Wix>
